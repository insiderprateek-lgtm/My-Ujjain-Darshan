# GEMINI_API_KEY: Required server-side for the Travel Buddy chatbot.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"
PORT="3000"

# PostgreSQL connection (use DATABASE_URL OR individual SQL_* variables)
DATABASE_URL=""
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_SSL="false"

# Admin access allowlist (comma-separated Google Sign-In emails with admin privileges)
ADMIN_EMAILS="insiderprateek@gmail.com"

# Lead email forwarding recipient (defaults to insiderprateek@gmail.com)
LEAD_NOTIFICATION_EMAIL="insiderprateek@gmail.com"
OPERATOR_NOTIFICATION_EMAIL="insiderprateek@gmail.com"
OPERATOR_WEBHOOK_URL=""

# Optional SMTP configuration for automatic email forwarding (e.g., Gmail App Password or custom SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional Resend API key (alternative to SMTP for automatic email forwarding)
RESEND_API_KEY=""

# Optional Google Analytics 4 / Tag Manager IDs (loaded only after visitor consent)
VITE_GA4_MEASUREMENT_ID=""
VITE_GTM_ID=""

# Optional Google Maps Embed API key for interactive circuit map enhancement
VITE_GOOGLE_MAPS_EMBED_KEY=""
